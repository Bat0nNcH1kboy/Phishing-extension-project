{
  "manifest_version": 3,
  "name": "Антифишинг URL Checker",
  "version": "2.0.0",
  "description": "Локальная гибридная проверка URL: база 100k, ML, эвристика и DNS.",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:5001/*",
    "http://127.0.0.1:5001/*"
  ],
  "action": {
    "default_title": "Проверить сайт",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}